# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/marina_cranes

# ─── Auth ──────────────────────────────────────────────────────────────────
# JWT secret for access tokens (short-lived, 15min) — generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secure-string
# JWT secret for refresh tokens (7 days) — generate: openssl rand -hex 32
JWT_REFRESH_SECRET=change-me-to-a-different-random-string

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@marina.hr

# ─── SMS (Infobip) ─────────────────────────────────────────────────────────
INFOBIP_BASE_URL=https://XXXXX.api.infobip.com
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_SENDER=Marina

# ─── Google OAuth 2.0 ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Billing API (read-only izlazni REST API) ──────────────────────────────
BILLING_API_KEY=change-me-to-a-secure-billing-api-key

# ─── Member Sync — Poslužitelj (Coolify) & Lokalni Agent ─────────────────
# Sigurnosni ključ za komunikaciju između lokalnog Windows agenta i Coolify poslužitelja
SYNC_API_KEY=postavite-sigurni-nasumicni-kljuc-npr-openssl-rand-hex-32

# ─── Lokalni Windows Agent (pokreće se na PC-u s Desktop aplikacijom) ─────
# Udaljeni URL produkcijske web aplikacije
REMOTE_SYNC_URL=https://dizalica.imagomatrix.com/api/v1/member-sync/push
# Pristup lokalnom MS SQL Serveru
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=brod
MSSQL_USER=sa
MSSQL_PASSWORD=vasa-mssql-lozinka
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERT=true
MEMBER_SYNC_INTERVAL_MIN=60

# ─── Node Environment ──────────────────────────────────────────────────────
NODE_ENV=development

# ─── e-racuni.com (Eurofaktura API Integracija) ───────────────────────────
ERACUNI_API_URL=https://eurofaktura.com/WebServicesHR/API
ERACUNI_USERNAME=vase-api-korisnicko-ime
ERACUNI_TOKEN=vas-web-services-token
ERACUNI_MD5PASS=vas-md5-api-password
ERACUNI_SANDBOX_MODE=true
ERACUNI_MOCK_ENABLED=false

